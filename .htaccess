# Used when this project sits inside a sub-folder of a website (e.g. /attendance).
# Compatible with both Apache and LiteSpeed Web Server.
Options -Indexes
DirectoryIndex public/index.php index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /attendance/

    # Allow direct access if already pointing to public/
    RewriteCond %{REQUEST_URI} ^/attendance/public/
    RewriteRule ^ - [L]

    # Serve static assets directly from public/ if they exist
    RewriteCond %{DOCUMENT_ROOT}/attendance/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public_html/attendance/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Send all other requests to public/index.php
    RewriteRule ^(.*)$ public/index.php [L,QSA]
</IfModule>

# Protect sensitive files and directories
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "(composer\.(json|lock)|package(-lock)?\.json|artisan|error_log|phpunit\.xml)$">
    Require all denied
</FilesMatch>
