# Keeps the real-time punch listener running, and restarts it after a crash or reboot.
# Install: sudo cp attendance-listener.service /etc/systemd/system/
#          sudo systemctl enable --now attendance-listener
[Unit]
Description=Attendance Hub - ZKTeco real-time listener
After=network-online.target mysql.service
Wants=network-online.target

[Service]
User=www-data
WorkingDirectory=/var/www/attendance-app
ExecStart=/usr/bin/php artisan zk:listen
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
